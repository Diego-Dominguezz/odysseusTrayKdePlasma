#!/usr/bin/env python3
import os, subprocess, sys, time, threading, webbrowser
from PyQt6.QtCore import QObject, pyqtSignal
from PyQt6.QtGui import QAction, QIcon
from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

ODYSSEUS_DIR=os.path.expanduser(os.environ.get('ODYSSEUS_DIR','~/Downloads/odysseus'))
LAUNCHER=os.path.expanduser('~/.local/bin/odysseus-launcher')
URL='http://127.0.0.1:7000'
ICON=os.path.expanduser('~/.local/share/icons/hicolor/scalable/apps/odysseus.svg')

class Controller(QObject):
    status_changed=pyqtSignal(str)
    def compose(self,*args):
        return subprocess.run(['docker','compose',*args],cwd=ODYSSEUS_DIR,capture_output=True,text=True)
    def is_running(self):
        return bool(self.compose('ps','-q','odysseus').stdout.strip())
    def start(self):
        if self.is_running(): self.status_changed.emit('Running'); return
        self.status_changed.emit('Starting...')
        subprocess.Popen([LAUNCHER],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
        threading.Thread(target=self.wait,daemon=True).start()
    def wait(self):
        for _ in range(90):
            if self.is_running(): self.status_changed.emit('Running'); return
            time.sleep(1)
        self.status_changed.emit('Check logs')
    def stop(self):
        self.status_changed.emit('Stopping...'); self.compose('down'); self.status_changed.emit('Stopped')
    def restart(self): self.stop(); time.sleep(2); self.start()
    def open(self): webbrowser.open(URL)
    def logs(self):
        subprocess.Popen(['konsole','--new-tab','-e','bash','-lc',f"cd '{ODYSSEUS_DIR}' && docker compose logs -f --tail=100 odysseus"])

app=QApplication(sys.argv); app.setQuitOnLastWindowClosed(False)
if not os.path.exists(ICON): sys.exit(f'Missing icon: {ICON}')
tray=QSystemTrayIcon(QIcon(ICON)); tray.setToolTip('Odysseus AI')
controller=Controller(); menu=QMenu()
status=QAction('● Starting...',menu); status.setEnabled(False); menu.addAction(status); menu.addSeparator()
for label,fn in [('Open Odysseus',controller.open),('Open Logs',controller.logs)]:
    a=QAction(label,menu); a.triggered.connect(fn); menu.addAction(a)
menu.addSeparator()
for label,fn in [('Start',controller.start),('Restart',controller.restart),('Stop',controller.stop)]:
    a=QAction(label,menu); a.triggered.connect(fn); menu.addAction(a)
menu.addSeparator(); q=QAction('Quit Tray',menu); q.triggered.connect(app.quit); menu.addAction(q)
tray.setContextMenu(menu); controller.status_changed.connect(lambda s: status.setText(f'● {s}')); tray.show(); controller.start()
sys.exit(app.exec())
